# Names only. Never commit values, and never paste one into a chat message —
# anything that appears in a conversation is treated as compromised and rotated.
#
# Public, and shipped in the client:
SHIFT_SUPABASE_URL=
SHIFT_SUPABASE_ANON_KEY=

# Server-side only. These go into GitHub Actions secrets and the Supabase
# dashboard directly, never into a build the browser downloads.
#
# The two SUPABASE_ names are unprefixed because the host injects them into
# every edge function under exactly those names — `_shared/handler.js` reads
# them as-is, so renaming them here would just mean nothing reads what you set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The vault master key: 32 bytes, base64 (44 characters, ending "="). Without
# it `provider-key` refuses to store anything, by design — a vault that
# silently encrypts under a predictable key is worse than one that will not
# start. Generate with:
#
#   openssl rand -base64 32
#
SHIFT_KMS_KEY=
SHIFT_KMS_KEY_ID=
SHIFT_STRIPE_SECRET_KEY=
SHIFT_STRIPE_WEBHOOK_SECRET=

# Where the app looks for updates. Overridden only for testing against a local
# stand-in release server; the default is the real GitHub API.
SHIFT_UPDATE_API=
