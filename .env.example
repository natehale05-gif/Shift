# Names only. Never commit values, and never paste one into a chat message —
# anything that appears in a conversation is treated as compromised and rotated.
#
# Public, and shipped in the client:
SHIFT_SUPABASE_URL=
SHIFT_SUPABASE_ANON_KEY=

# Server-side only. These go into GitHub Actions secrets and the Supabase
# dashboard directly, never into a build the browser downloads.
SHIFT_SUPABASE_SERVICE_ROLE_KEY=
SHIFT_KMS_KEY_ID=
SHIFT_STRIPE_SECRET_KEY=
SHIFT_STRIPE_WEBHOOK_SECRET=

# Where the app looks for updates. Overridden only for testing against a local
# stand-in release server; the default is the real GitHub API.
SHIFT_UPDATE_API=
